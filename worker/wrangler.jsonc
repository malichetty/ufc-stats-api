{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ufc-stats-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The custom domain is the only way in: no workers.dev URL, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ufcapi.aristotle.me", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ufc-stats",
      // Replaced with the real id when the database is created (needs Aris's yes).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP and per-key request limits, counted by Cloudflare per data centre. No billing.
  "ratelimits": [
    { "name": "RL_CEILING", "namespace_id": "4101", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_ANON", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_KEY", "namespace_id": "4103", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    "ANON_PER_DAY": "5000",
    "ANON_PER_MINUTE": "60",
    "KEY_PER_MINUTE": "600"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
